def external (name : String) : Bool :=
  (externalSymbols.map (·.replace "::" ".")).contains name

theorem external_listed (name : String) (admitted : external name = true) :
    name ∈ externalSymbols.map (·.replace "::" ".") := by
  simpa [external] using admitted

end AcornDocument
