{
  "workspaces": [
    {
      "dir": "lean",
      "lakeArgs": ["-f", "lakefile.lean", "--offline", "--no-cache"]
    },
    {
      "dir": "site",
      "lakeArgs": ["-f", "lakefile.toml", "--offline", "--no-cache"]
    }
  ],
  "exclude": [
    {
      "prefix": "site/AcornDocs.lean",
      "reason": "Verso #doc manual root page (documentation source, not Lean code)"
    },
    {
      "prefix": "site/AcornDocs/",
      "reason": "Verso #doc manual pages (documentation source, not Lean code)"
    }
  ],
  "ratchet": "comment-ratchet.json"
}
